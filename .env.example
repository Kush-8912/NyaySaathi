# Copy to .env.local and fill in. Never commit .env.local.

# Firebase web app config (Firebase Console -> Project settings -> Your apps).
# These are public identifiers, safe to expose; access is controlled by firestore.rules / storage.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Gemini API key (Google AI Studio). SECRET: server-only, no NEXT_PUBLIC_ prefix.
GEMINI_API_KEY=

# Optional: override the Gemini model (default: gemini-2.5-flash)
# GEMINI_MODEL=gemini-2.5-flash
